#!/bin/bash

chip=$(cat /factory/OEMconfig.ini | grep "CHIP =" | awk -F= '{print $2}' | sed 's/^ *//')
cpu_model=$(awk -F': ' '/^model name/{print $2; exit}' /proc/cpuinfo | tr '[:upper:]' '[:lower:]' | tr -d ' \t\r\n')
hw_chip=""
case "$cpu_model" in
    bm1688) hw_chip="BM1688" ;;
    cv186ah) hw_chip="CV186AH" ;;
    cv84x2) hw_chip="CV84X2" ;;
    cv84x4) hw_chip="CV84X4" ;;
    cv84x6) hw_chip="CV84X6" ;;
esac
if [ -n "$hw_chip" ]; then
    echo "SophonSDK($hw_chip) 2.3"
else
    echo "SophonSDK($chip) 2.3"
fi

#soc mode
dpkg -l | grep sophon-soc-libsophon | awk '{printf "%s : %s\n",$2,$3}'
dpkg -l | grep sophon-media-soc-sophon-ffmpeg | awk '{printf "%s : %s\n",$2,$3}'
dpkg -l | grep sophon-media-soc-sophon-opencv | awk '{printf "%s : %s\n",$2,$3}'
#pcie mode
dpkg -l | grep sophon-libsophon | awk '{printf "%s : %s\n",$2,$3}'
dpkg -l | grep sophon-media-sophon-ffmpeg | awk '{printf "%s : %s\n",$2,$3}'
dpkg -l | grep sophon-media-sophon-opencv | awk '{printf "%s : %s\n",$2,$3}'

if [ -f "/opt/sophon/libsophon-current/bin/version" ] \
    && dpkg -l | grep -q "sophon-soc-libsophon"; then
    /opt/sophon/libsophon-current/bin/version
fi
kern_version=$(uname -a)
echo "KernelVersion : $kern_version"\

