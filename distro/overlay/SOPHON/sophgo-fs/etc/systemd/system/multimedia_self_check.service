[Unit]
Description=Run sophon multimedia self-check after bmrt_setup.
After=bmrt_setup.service
Wants=bmrt_setup.service

[Service]
User=root
ExecStart=/usr/sbin/bm_multimedia_self_check.sh
Type=oneshot
StandardOutput=append:/dev/ttyS0
StandardError=append:/dev/ttyS0

[Install]
WantedBy=multi-user.target