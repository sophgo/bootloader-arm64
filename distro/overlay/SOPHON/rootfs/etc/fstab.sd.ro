/dev/mmcblk0p1	/boot		vfat	rw				0	1
/dev/mmcblk0p2	/recovery		vfat	rw				0	1
# /dev/mmcbk0p3	/env       ext4 defaults			0	0
# /dev/mmcblk0p5	/misc       ext4 defaults			0	0
/dev/mmcblk0p6	/media/root-ro	ext4	ro,errors=remount-ro,noauto	0	0
/dev/mmcblk0p7	/media/root-rw  ext4	defaults			0	0
/media/root-ro	/		overlay	lowerdir=/media/root-ro,upperdir=/media/root-rw/overlay,workdir=/media/root-rw/overlay-workdir	0	0
/dev/mmcblk0p8	/data           ext4	defaults			0	0
